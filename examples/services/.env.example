# Copy this file to .env and fill in your values

TZ=Europe/Paris
SERVER_IP=192.168.1.10

# Samba
SAMBA_PASSWORD=homelab

# WireGuard
WIREGUARD_URL=vpn.homelab.example.com
WIREGUARD_PORT=51820
WIREGUARD_PEERS=phone,laptop
WIREGUARD_ALLOWEDIPS=0.0.0.0/0

# Domain
DOMAIN=homelab.example.com
ACME_EMAIL=you@example.com
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# PostgreSQL superuser password (shared across all services)
POSTGRES_PASSWORD=change_me_strong_password

# Nextcloud admin credentials
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_nextcloud_password
