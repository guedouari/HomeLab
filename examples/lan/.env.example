# Copy this file to .env and fill in your values before running docker compose up

# Timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

# Samba — shared LAN credential (username is always "homelab")
# Windows users: prompted once, saved to Credential Manager, never asked again
# Linux/Android/iOS: connect as guest automatically, no prompt
# Default is homelab/homelab — override here if desired
SAMBA_PASSWORD=homelab

# PostgreSQL shared instance credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
