# Copy this file to .env and fill in your values before running docker compose up

# Timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

# Samba file sharing — password for the default user 'alice'
# To add more users, duplicate the ACCOUNT_alice line in docker-compose.yml
# with a new username and add a matching <username>_PASSWORD variable here.
SAMBA_PASSWORD=changeme

# PostgreSQL shared instance credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
