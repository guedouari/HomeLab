# Copy this file to .env and fill in your values before running docker compose up

# Timezone
TZ=Europe/Paris

# Server's static LAN IP
SERVER_IP=192.168.1.10

# Samba
SAMBA_PASSWORD=homelab

# WireGuard
# At Layer 2 use your Cloudflare-managed domain (e.g. vpn.homelab.example.com)
WIREGUARD_URL=vpn.homelab.example.com
WIREGUARD_PORT=51820
WIREGUARD_PEERS=phone,laptop
WIREGUARD_ALLOWEDIPS=0.0.0.0/0

# Domain — your Cloudflare-managed domain
DOMAIN=homelab.example.com

# Caddy — Let's Encrypt notification email
ACME_EMAIL=you@example.com

# Cloudflare API token
# Required permissions: Zone → DNS → Edit (for your zone only)
# Get it: Cloudflare Dashboard → Profile → API Tokens → Create Token
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
