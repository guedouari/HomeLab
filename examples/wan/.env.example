# Copy this file to .env and fill in your values before running docker compose up

# Timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

# Server's static LAN IP
# Used by WireGuard as PEERDNS and by Gatus for health checks
SERVER_IP=192.168.1.10

# Samba — shared LAN credential (username is always "homelab")
SAMBA_PASSWORD=homelab

# AdGuard Home — web UI password (hash stored in AdGuardHome.yaml, default: "homelab")
ADGUARD_PASSWORD=homelab

# WireGuard — public address clients use to connect
# Before Layer 2: use your public IP (run: curl ifconfig.me)
# At Layer 2: use your Cloudflare dynDNS hostname (e.g. vpn.homelab.example.com)
WIREGUARD_URL=your.public.ip.or.domain

# WireGuard — UDP port (must be forwarded on your router)
WIREGUARD_PORT=51820

# WireGuard — comma-separated peer names (or a number like 3)
# Configs auto-generated on first start. Add names and restart to add peers.
WIREGUARD_PEERS=phone,laptop

# WireGuard — tunnel mode
# 0.0.0.0/0              → full tunnel (all client traffic through VPN, ads filtered globally)
# 192.168.1.0/24         → split tunnel (LAN access only, client internet goes direct)
WIREGUARD_ALLOWEDIPS=0.0.0.0/0
